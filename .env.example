NODE_ENV=development
PORT=3333

WEB_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Quantos proxies confiaveis ficam na frente da API (load balancer, CDN). 0 = nenhum.
# Com 1, o IP do cliente vem do X-Forwarded-For (limites de requisicao por IP).
TRUST_PROXY=0

DATABASE_URL=postgresql://sinapse:sinapse@localhost:5432/sinapse
REDIS_URL=redis://localhost:6379

# gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me

# Storage: "local" (pasta uploads/, para dev) ou "s3" (S3, Cloudflare R2, MinIO).
# Com s3 o bucket fica privado: a API serve as fotos em /uploads/avatars.
STORAGE_DRIVER=local
# URL publica de /uploads da API (base do avatarUrl). Vazio = http://localhost:PORT/uploads.
# Obrigatoria em producao, ex. https://api.sinapse.app/uploads
STORAGE_PUBLIC_URL=
# So com STORAGE_DRIVER=s3. R2: endpoint https://<account-id>.r2.cloudflarestorage.com e regiao auto.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# true no MinIO
STORAGE_FORCE_PATH_STYLE=false

MAIL_FROM="Sinapse <nao-responda@sinapse.app>"
SMTP_URL=smtp://localhost:1025

# Assinatura (so o provedor de teste por enquanto). Precos em centavos, de exemplo.
BILLING_PROVIDER=fake
# gere com: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=change-me-change-me-change-me-change-me
BILLING_PRICE_MONTHLY_CENTS=2990
BILLING_PRICE_YEARLY_CENTS=29900
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=5

# FSRS (opcional; vazio = padrao do ts-fsrs)
FSRS_REQUEST_RETENTION=
FSRS_MAXIMUM_INTERVAL=
FSRS_ENABLE_FUZZ=false
FSRS_WEIGHTS=
